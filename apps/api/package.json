{
  "name": "@chipperly/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config test/vitest.config.ts",
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "import:rails": "node --env-file=.env --import tsx scripts/import-rails.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@chipperly/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.4.0",
    "jose": "^6.2.12",
    "p-queue": "^9.3.3",
    "postgres": "^3.4.9",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
