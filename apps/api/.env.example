# postgres://... runtime role (least privilege; used by every request)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/chipperly
# postgres://... migrations role; defaults to DATABASE_URL when unset
DATABASE_URL_OWNER=
# API listen port
PORT=8080
# API listen host
HOST=127.0.0.1
# HS256 signing secret for access tokens, >= 32 chars
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Path to the Next.js static export to serve; unset = API only, no static hosting
WEB_DIR=
# Path prefix the API and static files are mounted under, e.g. /chipperly; API mounts at ${BASE_PATH}/api
BASE_PATH=
# Allowed CORS origin; unset = same-origin only. Dev: http://localhost:3000
CORS_ORIGIN=
# Local disk directory for the `local` storage driver
UPLOAD_DIR=./uploads
# local | s3
STORAGE_DRIVER=local
# S3-compatible endpoint (R2, B2, MinIO, ...), only used when STORAGE_DRIVER=s3
S3_ENDPOINT=
# Bucket name, only used when STORAGE_DRIVER=s3
S3_BUCKET=
# Access key id, only used when STORAGE_DRIVER=s3
S3_ACCESS_KEY_ID=
# Secret access key, only used when STORAGE_DRIVER=s3
S3_SECRET_ACCESS_KEY=
# Public base URL media is served from when STORAGE_DRIVER=s3, e.g. https://media.example.com
MEDIA_PUBLIC_BASE=
# Google OAuth client id; unset = POST /auth/google 404s and GET /auth/providers reports google:false
GOOGLE_OAUTH_CLIENT_ID=
# Sign in with Apple: all four of these must be set together, or apple stays disabled
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# The web Apple button also needs its own NEXT_PUBLIC_APPLE_CLIENT_ID set (apps/web/.env.example); this is server-side only
# Closed beta invite code; unset = registration is open. Set = POST /auth/register requires a matching invite_code
# (a valid invite_token bypasses it), and /auth/google, /auth/apple require it only for a brand-new user
BETA_INVITE_CODE=
# Resend API key; unset = mail is logged to stdout instead of sent
RESEND_API_KEY=
# From address used on every outgoing email
MAIL_FROM=Chipperly <no-reply@chipperlyapp.com>
# Public origin used in emails and share links, e.g. https://demos.linkedtrust.us
APP_ORIGIN=
# pino log level
LOG_LEVEL=info

# Stripe. Billing is OFF unless BOTH the secret key and the webhook secret are set:
# every /billing/* route 404s and the web app hides the upgrade path entirely.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One price id per account kind. A kind with no price id cannot check out
# (409 price_not_set). Amounts are read live from Stripe, never hardcoded.
STRIPE_PRICE_INDIVIDUAL=
STRIPE_PRICE_HOUSEHOLD=
STRIPE_PRICE_SUPPORTED=
STRIPE_PRICE_AGENCY=
# Chipperly's cut of a community sale, 0-100 (e.g. 10 or 2.5). There is no default:
# unset means nothing can be priced or bought.
COMMUNITY_PLATFORM_FEE_PERCENT=
# Signing secret of the SEPARATE "connected accounts" webhook endpoint. Stripe signs
# Connect events (account.updated) with their own secret, not the platform one.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Openverse image search (optional). Both unset = /images/search and /images/import 404 and the
# web app hides "Search images". Register an app at https://api.openverse.org/v1/auth_tokens/register/
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
