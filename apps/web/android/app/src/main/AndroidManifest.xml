<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Disclosed, narrow-purpose accessibility service: watches only
             which package is in the foreground (see
             chipperly_block_service_config.xml, where canRetrieveWindowContent
             is false) so Chipperly can bring itself back when a
             non-allowed app opens while the device is locked to a child's
             profile. The caregiver must turn it on manually in system
             Settings; block_service_description (strings.xml) is what they
             read there before doing so. -->
        <service
            android:name=".ChipperlyBlockService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/chipperly_block_service_config" />
        </service>

        <!-- Overrides @capacitor/push-notifications' own manifest entry
             (its MessagingService) so a locate_request data message is
             handled even with the app fully killed. See
             LocateRequestMessagingService, which calls super.onMessageReceived
             first so the plugin's own notification-message handling still
             works unchanged. -->
        <service
            android:name=".LocateRequestMessagingService"
            android:exported="false"
            tools:node="replace">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @capacitor/geolocation: the plugin's own manifest declares no
         permissions (confirmed in its README/AndroidManifest.xml), so the
         app must declare these itself for the merger to include them. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
