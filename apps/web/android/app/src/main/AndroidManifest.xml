<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Disclosed, narrow-purpose accessibility service: watches only
             which package is in the foreground (see
             chipperly_block_service_config.xml, where canRetrieveWindowContent
             is false) so Chipperly can bring itself back when a
             non-allowed app opens while the device is locked to a child's
             profile. The caregiver must turn it on manually in system
             Settings; block_service_description (strings.xml) is what they
             read there before doing so. -->
        <service
            android:name=".ChipperlyBlockService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/chipperly_block_service_config" />
        </service>

        <!-- Registers this app as eligible for Device Owner status. On its
             own this does nothing and prompts nobody: it only takes effect
             once a caregiver runs `adb shell dpm set-device-owner
             org.chipperly.app/.ChipperlyDeviceAdminReceiver` from a computer,
             which Android only accepts on a device with no accounts added
             yet. That one-time step is what turns setLockTaskPackages
             (AppBlockerPlugin) from a best-effort accessibility redirect
             into a real OS-enforced multi-app kiosk allowlist that survives
             Force Stop and Recents. -->
        <receiver
            android:name=".ChipperlyDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Removes @capacitor/push-notifications' own MessagingService
             entry: tools:node="replace" only works when android:name
             matches, and this override's is deliberately different (a
             LocateRequestMessagingService subclass, below), so without this
             removal both services end up registered for the same
             com.google.firebase.MESSAGING_EVENT action, an ambiguity that
             silently drops FCM delivery to either. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <!-- Replaces it: handles a locate_request data message even with
             the app fully killed. Calls super.onMessageReceived() first so
             the plugin's own notification-message handling still works
             unchanged. -->
        <service
            android:name=".LocateRequestMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

    <!-- Package visibility (Android 11+, API 30): without this, this app's
         own PackageManager queries only see a small system allowlist
         (confirmed: Settings, Play Store, the SIM toolkit, nothing else,
         not even YouTube), even though every launchable app is still
         visible to a privileged caller like `adb shell`. Declares the two
         intents this app actually resolves against:
         MAIN/LAUNCHER (AppBlockerPlugin.listInstalledApps: every
         launchable app, for the caregiver's allow-list picker) and
         MAIN/HOME (ChipperlyBlockService.resolveLauncherPackage: the
         system launcher itself, always allowed so blocking never traps
         the device with no way to reach any app at all). Verified this
         second one was silently broken by only declaring the first:
         resolveLauncherPackage returned null, so pressing Home while
         blocking was on bounced straight back to Chipperly instead of
         showing the launcher. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- SpeechPlugin (read-aloud): Android 11+ hides the TTS engine from apps that don't declare it. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Recording a story page in your own voice (components/story/VoiceRecorder.tsx):
         Capacitor's WebChromeClient asks for these at runtime when the page calls getUserMedia. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- @capacitor/geolocation: the plugin's own manifest declares no
         permissions (confirmed in its README/AndroidManifest.xml), so the
         app must declare these itself for the merger to include them. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- A locate_request FCM message (LocateRequestMessagingService) runs
         with no foreground Activity, which Android counts as "background"
         for location access regardless of what triggered it, and this is
         required on top of the two above or getCurrentLocation silently
         yields nothing there. Can't be requested in the same dialog as the
         two above (Android 11+ drops it if you try); DeviceLocatorPlugin's
         openLocationSettings sends the caregiver to grant it by hand
         instead, same pattern as openAccessibilitySettings below. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- LockNotifier's lock/unlock confirmation, Android 13+. Requested at
         runtime by PushRegistrationGuard's existing PushNotifications.requestPermissions()
         call, not a new flow: notifications and push already need the same grant. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AppBlockerPlugin.requestIgnoreBatteryOptimizations: lets the caregiver
         exempt Chipperly from Doze/App Standby so ChipperlyBlockService's
         relaunch of a blocked app doesn't have to cold-start a killed process. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
