# Path prefix the app is deployed under, e.g. /chipperly; empty = root
NEXT_PUBLIC_BASE_PATH=
# API origin; empty = same origin as the web app
NEXT_PUBLIC_API_ORIGIN=
# Public site origin used for absolute links (sitemap, manifest, share)
NEXT_PUBLIC_SITE_ORIGIN=
# Google OAuth client id; unset = Google sign-in button hidden
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Sign in with Apple client (services) id; unset = Apple sign-in button hidden
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Google Search Console HTML tag verification value
NEXT_PUBLIC_GSC_VERIFICATION=
# Google Analytics 4 measurement id
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Microsoft Clarity project id
NEXT_PUBLIC_CLARITY_PROJECT_ID=
