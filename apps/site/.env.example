# No database URL: data lives in Cloudflare D1 and media in R2 (wrangler.jsonc).
# Local dev uses a local D1/R2 under .wrangler/state; nothing to install.
# Long random string; signs admin sessions. `openssl rand -hex 32`
# On Cloudflare: `wrangler secret put PAYLOAD_SECRET`.
PAYLOAD_SECRET=
# Public origin of this site: canonical URLs, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# The Chipperly web app: "Sign in" and "Try the app" link here.
NEXT_PUBLIC_APP_URL=https://demos.linkedtrust.us/chipperly-next
# Used once by `pnpm seed` to create the first admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Microsoft Clarity: CLARITY_ID is set in wrangler.jsonc "vars" for the live
# Worker. It never loads in dev, on localhost or any other host.
