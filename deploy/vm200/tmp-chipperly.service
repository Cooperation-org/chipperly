[Unit]
Description=tmp: Chipperly demo API + static app at demos.linkedtrust.us/chipperly/ (expires 2026-11-18)
After=network.target tmp-chipperly-db.service
Requires=tmp-chipperly-db.service

[Service]
User=mhany
WorkingDirectory=/home/mhany/chipperly/apps/api
EnvironmentFile=/home/mhany/chipperly/apps/api/.env
ExecStart=/home/mhany/.nvm/versions/node/v22.22.1/bin/node dist/server.js
Restart=always
RestartSec=5
MemoryMax=1G

[Install]
WantedBy=multi-user.target
