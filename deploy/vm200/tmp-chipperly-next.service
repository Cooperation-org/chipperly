[Unit]
Description=tmp: Chipperly (new app) demo API + static app at demos.linkedtrust.us/chipperly-next/ (expires 2026-11-18)
After=network.target tmp-chipperly-next-db.service
Requires=tmp-chipperly-next-db.service

[Service]
User=mhany
WorkingDirectory=/home/mhany/chipperly/apps/api
EnvironmentFile=/home/mhany/chipperly/apps/api/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
MemoryMax=1G

[Install]
WantedBy=multi-user.target
