[Unit]
Description=Chipperly API + static app (app.chipperlyapp.com)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=mhany
WorkingDirectory=/home/mhany/chipperly/apps/api
EnvironmentFile=/home/mhany/chipperly/apps/api/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
MemoryMax=2G

[Install]
WantedBy=multi-user.target
