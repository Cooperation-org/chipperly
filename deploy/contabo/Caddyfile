app.chipperlyapp.com {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	reverse_proxy 127.0.0.1:8064
}

# The admin site: the same build and API, its own address (13 Oct 2026). Sign-in there
# goes to /admin/; the API's admin routes check the role either way.
admin.chipperlyapp.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:8064
}

# The dev copy: branch dev, its own unit, database and uploads on 127.0.0.1:8065 (28 Oct 2026).
# The password lives only on the server, in /etc/caddy/dev-auth (README.md, "Dev copy").
# Stripe's sandbox webhook cannot type a password, so that one path stays open; Stripe signs it.
(dev) {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	header X-Robots-Tag "noindex, nofollow"
	@locked not path /api/billing/webhook
	import /etc/caddy/dev-auth
	reverse_proxy 127.0.0.1:8065
}

dev-app.chipperlyapp.com {
	import dev
}

dev-admin.chipperlyapp.com {
	import dev
}
